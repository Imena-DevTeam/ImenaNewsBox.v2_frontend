#!/bin/sh
#
# Refuses a push that would rewrite history on the remote, and refuses a push
# straight to main.
#
# Force is not detected from the command line — git does not pass the flag to
# this hook. It is detected from the refs themselves: if what is already on the
# remote is not an ancestor of what is being pushed, the push would discard
# commits. That catches --force and --force-with-lease alike.
#
# Deliberate exception, for the rare case it is genuinely needed:
#   ALLOW_FORCE_PUSH=1 git push ...
#
# Installed for everyone via:  git config core.hooksPath .githooks

remote="$1"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Branch being deleted.
    if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: refusing to delete $remote_ref on $remote." >&2
        echo "          Delete it on GitHub if you really mean to." >&2
        blocked=1
        continue
    fi

    # Pushing straight to main, rather than through a pull request.
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "pre-push: refusing to push straight to $remote_ref." >&2
            echo "          Open a pull request instead." >&2
            blocked=1
            continue
            ;;
    esac

    # New branch on the remote: nothing can be lost.
    [ "$remote_sha" = "$zero" ] && continue

    # Anything already on the remote must be contained in what we are pushing.
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "pre-push: refusing to rewrite history on $remote_ref." >&2
        echo "          $(git rev-parse --short "$remote_sha") on the remote is not an ancestor" >&2
        echo "          of $(git rev-parse --short "$local_sha"); this push would discard commits" >&2
        echo "          that someone else may be working from." >&2
        echo "          If you are certain:  ALLOW_FORCE_PUSH=1 git push ..." >&2
        blocked=1
    fi
done

if [ "$blocked" = "1" ]; then
    if [ "${ALLOW_FORCE_PUSH:-}" = "1" ]; then
        echo "pre-push: ALLOW_FORCE_PUSH=1 set — allowing it." >&2
        exit 0
    fi
    exit 1
fi

exit 0
