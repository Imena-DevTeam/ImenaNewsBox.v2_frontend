# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Where the API is, with its /api/v1 prefix. Server-only: the Next server
# makes every call and holds the tokens, and the browser never sees this
# address (CLAUDE.md §23). Read by lib/env.ts; unset, any call through a
# service fails with a message naming this variable.
# Locally: `uv run fastapi dev src/app/main.py` in ../backend-v2.
API_URL=http://127.0.0.1:8000/api/v1

# This site's own origin, sent as Origin on every call. The backend checks it
# on refresh and logout against its CORS_ORIGINS, so the two must agree.
FRONTEND_ORIGIN=http://localhost:3000

# Optional. How long one request may take before it is given up on, in
# milliseconds. Defaults to 10000.
API_TIMEOUT_MS=

# Optional. Where `pnpm api:types` fetches the backend's OpenAPI schema from.
# Defaults to http://127.0.0.1:8000; production does not serve one.
API_SCHEMA_URL=

# Signs the session cookie (role and id) and the login-in-progress cookie.
# Generate one with: npx auth secret
# Unset in production, nothing can be signed and nobody can sign in, which is
# the right way round. Changing it signs every device out of this frontend.
AUTH_SECRET=

# Leave API_URL empty to work without a backend: outside production, the
# sample register signs people in with any five digits (lib/auth-mode.ts).
# Administrators then use the development passwords in features/auth/admin.ts.

# Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
