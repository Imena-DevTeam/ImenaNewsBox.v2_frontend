# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Where the API is. Read by lib/env.ts and used by lib/api-client.ts; nothing
# else reads it directly. Unset, any call through a service fails with a
# message naming this variable rather than a broken URL.
NEXT_PUBLIC_API_URL=https://api.imena.example/v1

# Optional. When set, server-side calls go here instead, so a deployment can
# reach the API over an internal address while the browser uses the public
# one. Leave empty if there is only one address.
API_URL=

# Optional. How long one request may take before it is given up on, in
# milliseconds. Defaults to 10000.
API_TIMEOUT_MS=

# Auth.js — generate a secret with: npx auth secret
# Signs the session cookie and the pending-login cookie. Unset in production,
# nothing can be signed and nobody can sign in, which is the right way round.
AUTH_SECRET=

# The administrators' password, checked by features/auth/admin.ts against an
# address that is an administrator's in the register. Unset in production,
# administrator sign-in is unavailable rather than open. Development falls
# back to a known value; see that file.
ADMIN_PASSWORD=12345678

# Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
